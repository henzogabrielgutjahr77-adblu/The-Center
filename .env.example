# The Center - Environment Variables Example
# Copy to .env and fill in real values. NEVER commit actual .env files.

# Desktop (client)
VITE_SERVER_URL=http://localhost:4000

# Server (backend)
NODE_ENV=development
PORT=4000

# String de conexão do PostgreSQL.
# Exemplo para o banco local via docker-compose (valor não-secreto de dev):
DATABASE_URL=postgres://thecenter:thecenter_dev_password@localhost:5432/thecenter

# Nível de log do pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Server (placeholder - not used by desktop yet)
# SESSION_SECRET=change-me