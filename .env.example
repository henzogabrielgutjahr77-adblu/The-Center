# The Center - Environment Variables Example
# Copy to .env and fill in real values. NEVER commit actual .env files.

# Desktop (client) - server base URL used by the desktop HTTP client
# Reading: import.meta.env.VITE_SERVER_URL (see apps/desktop/src/lib/api/config.ts)
VITE_SERVER_URL=http://localhost:3000

# Server (for the backend team - placeholder, not used by desktop yet)
# SERVER_PORT=3000
# SESSION_SECRET=change-me
