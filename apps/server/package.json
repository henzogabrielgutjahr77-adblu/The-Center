{
  "name": "@the-center/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx --import ./src/preload.ts src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import ./dist/preload.js dist/index.js",
    "lint": "echo 'lint: não configurado ainda'",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "dependencies": {
    "@the-center/api-types": "workspace:*",
    "@the-center/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
